/dts-v1/;

/ {
    model = "QNAP TS-209 Pro II";
    compatible = "qnap,ts209pro2",
                 "marvell,rd-88f5182-nas-2-le",
                 "marvell,orion5x-88f5182";

    #address-cells = <1>;
    #size-cells = <1>;

    memory@0 {
        device_type = "memory";
        reg = <0x00000000 0x10000000>;
    };

    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "console=ttyS0,115200n8 earlyprintk";
    };

    aliases {
        serial0 = &uart0;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;

        cpu@0 {
            device_type = "cpu";
            compatible = "arm,arm926ej-s";
            reg = <0>;
        };
    };

    internal-regs@f1000000 {
        compatible = "marvell,orion5x-mbus", "simple-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        ranges = <0x0 0xf1000000 0x100000>;

        interrupt-controller@20200 {
            compatible = "marvell,orion-intc";
            reg = <0x20200 0x20>;
            interrupt-controller;
            #interrupt-cells = <1>;
        };

        uart0: serial@12000 {
            compatible = "ns16550a";
            reg = <0x12000 0x100>;
            reg-shift = <2>;
            interrupts = <3>;
            clock-frequency = <166000000>;
            status = "okay";
        };
    };
};

